        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n      DIM_PATIENT ||--o{ FACT_CLINICAL_COHORT : \&quot;has\&quot;\n      DIM_CLINICAL_METRICS ||--o{ FACT_CLINICAL_COHORT : \&quot;measures\&quot;\n      DIM_AHA_GUIDELINES ||--o{ FACT_CLINICAL_COHORT : \&quot;classifies\&quot;\n\n      DIM_PATIENT {\n          int person_id PK \&quot;Mã định danh bệnh nhân\&quot;\n          int age \&quot;Tuổi (18-100)\&quot;\n          int is_male \&quot;Giới tính (0: Nữ, 1: Nam)\&quot;\n          int education \&quot;Trình độ học vấn (1-4)\&quot;\n          int current_smoker \&quot;Tình trạng hút thuốc (0/1)\&quot;\n          int cigs_per_day \&quot;Số điếu thuốc / ngày\&quot;\n          int prevalent_stroke \&quot;Tiền sử đột quỵ (0/1)\&quot;\n          int prevalent_hyp \&quot;Tiền sử tăng huyết áp (0/1)\&quot;\n          string center_source \&quot;Trung tâm y tế (Framingham / Cardio)\&quot;\n      }\n\n      DIM_CLINICAL_METRICS {\n          int metric_id PK \&quot;Mã bản ghi chỉ số đo\&quot;\n          int person_id FK \&quot;Liên kết bệnh nhân\&quot;\n          float tot_chol \&quot;Cholesterol toàn phần (mg/dL)\&quot;\n          float sys_bp \&quot;Huyết áp tâm thu (mmHg)\&quot;\n          float dia_bp \&quot;Huyết áp tâm trương (mmHg)\&quot;\n          float BMI \&quot;Chỉ số khối cơ thể\&quot;\n          float heart_rate \&quot;Nhịp tim (lần/phút)\&quot;\n          float glucose \&quot;Đường huyết (mg/dL)\&quot;\n          int bp_meds \&quot;Thuốc điều hòa HA (0/1)\&quot;\n          int diabetes \&quot;Bệnh tiểu đường (0/1)\&quot;\n      }\n      DIM_AHA_GUIDELINES {\n          int guideline_id PK \&quot;Mã cấp độ khuyến cáo (1-5)\&quot;\n          string bp_stage \&quot;Phân tầng (NORMAL, STAGE_1, STAGE_2,...)\&quot;\n          float min_sys_bp \&quot;Ngưỡng tâm thu tối thiểu\&quot;\n          float max_sys_bp \&quot;Ngưỡng tâm thu tối đa\&quot;\n          float min_dia_bp \&quot;Ngưỡng tâm trương tối thiểu\&quot;\n          float max_dia_bp \&quot;Ngưỡng tâm trương tối đa\&quot;\n          string clinical_action \&quot;Hành động can thiệp lâm sàng\&quot;\n          string icd10_code \&quot;Mã bệnh quốc tế (I10, I10.9,...)\&quot;\n      }\n      FACT_CLINICAL_COHORT {\n          int event_id PK \&quot;Mã sự kiện ca bệnh\&quot;\n          int person_id FK \&quot;Khóa ngoại trỏ dim_patient\&quot;\n          int metric_id FK \&quot;Khóa ngoại trỏ dim_clinical_metrics\&quot;\n          int guideline_id FK \&quot;Khóa ngoại trỏ dim_aha_guidelines\&quot;\n          int ten_year_chd \&quot;Biến cố tim mạch 10 năm (Target: 0/1)\&quot;\n          vector phenotype_vector \&quot;Véc-tơ thể trạng 8 chiều (k-NN AI)\&quot;\n      }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="jX-O6232lcp50370PAJq-1">
